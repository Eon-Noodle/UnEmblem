@@ -1792,6 +1792,23 @@ class EquipItem(EventCommand):
         """
 Forces *GlobalUnit* to equip *Item*.
 
+The event will produce no effect if the item does not exist in the unit's inventory yet.
+It will also produce no effect if the item cannot be equipped by that unit.
+If the item chosen is a multi-item, the top-most valid option will be equipped.
+If the *recursive* flag is set, the event will first attempt to equip items directly
+in the unit's inventory, and then if no matching item is found, check the sub-items of multi-items.
+        """
+
+    keywords = ["GlobalUnit", "Item"]
+    _flags = ['recursive']
+
+class OffhandItem(EventCommand):
+    nid = 'offhand_item'
+    tag = Tags.MODIFY_UNIT_PROPERTIES
+    desc = \
+        """
+Forces *GlobalUnit* to offhand *Item*.
+
 The event will produce no effect if the item does not exist in the unit's inventory yet.
 It will also produce no effect if the item cannot be equipped by that unit.
 If the item chosen is a multi-item, the top-most valid option will be equipped.
diff --git a/app/events/event_functions.py b/app/events/event_functions.py
index 5fdbec41f..2012a99b2 100644
--- a/app/events/event_functions.py
+++ b/app/events/event_functions.py
@@ -1709,6 +1709,31 @@ def equip_item(self: Event, global_unit, item, flags=None):
     else:
         self.logger.error("equip_item: %s is not an item that can be equipped" % item.nid)
 
+def offhand_item(self: Event, global_unit, item, flags=None):
+    flags = flags or set()
+    recursive_flag = 'recursive' in flags
+    item_input = item
+    unit = self._get_unit(global_unit)
+    if not unit:
+        self.logger.error("offhand_item: Couldn't find unit with nid %s" % global_unit)
+        return
+    unit, item = self._get_item_in_inventory(global_unit, item, recursive=recursive_flag)
+    if not unit or not item:
+        self.logger.error("offhand_item: Item %s was invalid, see above" % item_input)
+        return
+    if item.multi_item:
+        for subitem in item.subitems:
+            if unit.can_offhand(subitem):
+                equip_action = action.OffhandItem(unit, subitem)
+                action.do(equip_action)
+                return
+        self.logger.error("offhand_item: No valid subitem to equip in %s" % item.nid)
+    elif unit.can_offhand(item):
+        equip_action = action.OffhandItem(unit, item)
+        action.do(equip_action)
+    else:
+        self.logger.error("offhand_item: %s is not an item that can be equipped" % item.nid)
+
 def remove_item(self: Event, global_unit_or_convoy, item, party=None, flags=None):
     flags = flags or set()
     global_unit = global_unit_or_convoy
