+    def find_euclidean_spheres(self, rng, x, y):
+        if not rng:
+            return set()
+        points = set()
+        r = max(rng) + 0.5
+        for dx in rng:
+            if dx == 0:
+                for dy in rng:
+                    if dy == 0:
+                        points.add((x, y))
+                    else:
+                        points.update({(x, y + dy),
+                                       (x, y - dy)})
+                continue
+            points.update({(x + dx, y),
+                           (x - dx, y)})
+            max_dy = int((r*r - dx*dx)**0.5)
+            for dy in range(1, max_dy+1):
+                points.update({(x + dx, y + dy),
+                               (x + dx, y - dy),
+                               (x - dx, y + dy),
+                               (x - dx, y - dy)})
+        return points
+
