[
    {
        "name": "Enter New Room",
        "trigger": "on_region_interact",
        "level_nid": "Union",
        "condition": "True",
        "commands": [],
        "only_once": false,
        "priority": 20,
        "_source": [
            "if;region.nid == 'Entrance_Hallway'",
            "    t;close",
            "    change_tilemap;Hallway;;Hallway;reload",
            "    enable_fog_of_war;false",
            "    trigger_script;Union Setup",
            "    t;open",
            "",
            "elif;region.nid == 'Entrance_Roundtable'",
            "    t;close",
            "    music_clear",
            "    change_tilemap;Roundtable",
            "    add_weather;purple",
            "    enable_fog_of_war;true",
            "    set_fog_of_war;fancy_thracia;1",
            "    add;{unit};7,14;;;south",
            "    ",
            "    if;game.quest_manager.is_quest_phase()",
            "        add;Apoccy;{v:pos_apoccy};immediate",
            "    end",
            "    for;layer;['gears', 'roundtable_upper', 'roundtable_lower'] + ['seat_%d' % (idx+1) for idx in range({v:roundtable_seat})]",
            "        show_layer;{layer};immediate",
            "    endf",
            "    if;{v:union_torch_lit}",
            "        for;un_pos;[(1,5), (3,2), (11,2), (13,5)]",
            "            add_region;vision_region|{un_pos};{un_pos};1,1;vision;0",
            "        endf",
            "        add_region;vision_apoccy;{v:pos_apoccy};1,1;vision;3",
            "        center_cursor;{unit}",
            "    else",
            "        center_cursor;{eval:utils.tuple_sub({v:pos_apoccy}, (0, 2))}",
            "    end",
            "    ",
            "    t;open",
            "    if;not {v:union_torch_lit}",
            "        gvar;union_torch_lit;True",
            "        for;un_pos;[(1,5), (3,2), (11,2), (13,5)]",
            "            sound;FireBall;0.7",
            "            add_region;vision_region|{un_pos};{un_pos};1,1;vision;0",
            "            wait;800",
            "        endf",
            "        sound;FireBall",
            "        add_region;vision_apoccy;{v:pos_apoccy};1,1;vision;3",
            "        wait;800",
            "        highlight;{unit}",
            "    end",
            "",
            "    m;Quest",
            "    change_music;player_phase;Quest",
            "    ",
            "    add_region;Entrance_Hallway;{unit};1,1;event;''",
            "    add_region;Roundtable_Seat;{eval:utils.tuple_sub({v:pos_apoccy}, (0, 3))};1,1;event;''",
            "    ",
            "    lvar;un_idx;1",
            "    for;un_unit;game.get_units_in_party()",
            "        if;'{un_unit}' != 'Fuuko'",
            "            add;{un_unit};7,14;immediate;stack",
            "            move;{un_unit};{eval:utils.tuple_add({v:pos_apoccy}, {v:pos_roundtable}[{v:un_idx}])};;;;no_block",
            "            linc;un_idx;1",
            "        end",
            "    endf",
            "end"
        ],
        "nid": "Union Enter New Room"
    }
]