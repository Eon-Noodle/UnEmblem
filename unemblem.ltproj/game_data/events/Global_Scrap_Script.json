[
    {
        "name": "Scrap Script",
        "trigger": null,
        "level_nid": null,
        "condition": "False",
        "commands": [],
        "only_once": false,
        "priority": 20,
        "_source": [
            "#################################################",
            "#                                               #",
            "#   TEMPORARY SPACE TO HOLD AND TEST SCRIPT     #",
            "#                                               #",
            "#################################################",
            "",
            "#   Find units with Unbreakable",
            "for;un_unit;game.get_player_units()",
            "    if;u(\"{un_unit}\").get_skill(\"Unbreakable\")",
            "    ",
            "        #   Pick a weapon from bottom-to-up",
            "        level_var;weapon_found;False",
            "        for;unit_item;u(\"{un_unit}\").items[::-1]          ",
            "            level_var;is_breakable;get_item(u(\"{un_unit}\"), {unit_item}).components.get(\"uses\") != None",
            "            level_var;is_weapon;item_funcs.is_weapon_recursive(u(\"{un_unit}\"), get_item(u(\"{un_unit}\"), {unit_item}))",
            "                        ",
            "            if;not {v:weapon_found} and {v:is_weapon} and {v:is_breakable}",
            "                level_var;weapon_found;True",
            "                ",
            "                #   Make the weapon Unbreakable",
            "                remove_item_component;{un_unit};{unit_item};uses",
            "                level_var;item_name;get_item(u(\"{un_unit}\"), {unit_item}).name",
            "                level_var;item_icon;get_item(u(\"{un_unit}\"), {unit_item}).nid",
            "                alert;<blue>{v:item_name}</> upgraded successfully!;{v:item_icon}",
            "            end",
            "        endf",
            "                       ",
            "        #   If unit is a blacksmith, level up",
            "        if;u(\"{un_unit}\").klass == \"Blacksmith\" and u(\"{un_unit}\").level < 20",
            "            autolevel_to;{un_unit};{eval: u(\"{un_unit}\").level + 1}",
            "            alert;<blue>{un_unit}</> leveled up!",
            "        end",
            "    end",
            "endf",
            "",
            "",
            "#   Find position of tile",
            "if;'{v:un_dir}' == 'north'",
            "    level_var;un_pos;(u('{un_unit}').position[0] + int(un_col) * int(mode), u('{un_unit}').position[1] - int(un_row))",
            "elif;'{v:un_dir}' == 'south'",
            "    level_var;un_pos;(u('{un_unit}').position[0] + int(un_col) * int(mode), u('{un_unit}').position[1] + int(un_row))",
            "elif;'{v:un_dir}' == 'east'",
            "    level_var;un_pos;(u('{un_unit}').position[0] + int(un_row), u('{un_unit}').position[1] + int(un_col) * int(mode))",
            "else",
            "    level_var;un_pos;(u('{un_unit}').position[0] - int(un_row), u('{un_unit}').position[1] + int(un_col) * int(mode))",
            "end",
            "",
            "if;target_pos[0] == position[0]",
            "    if;target_pos[1] < position[1]",
            "        level_var;un_dir;\"north\"",
            "    else",
            "        level_var;un_dir;\"south\"",
            "    end",
            "else",
            "    if;target_pos[0] < position[0]",
            "        level_var;un_dir;\"west\"",
            "    else",
            "        level_var;un_dir;\"east\"",
            "    end",
            "end",
            "",
            "############################################################################################",
            "",
            "level_var;un_pos;game.cursor.path[1] if game.cursor.path and len(game.cursor.path) - 1 + unit.movement_left < unit.get_stat('MOV') else [act.old_pos for act in game.action_log.actions if hasattr(act, 'rescuee') and act.unit == unit][-1] if unit.has_rescued else [act.other.position for act in game.action_log.actions if hasattr(act, 'other') and act.unit == unit][-1] if unit.has_taken else game.cursor.path[1]",
            "",
            "############################################################################################",
            "",
            "if;len(game.get_units_in_party()) < min({v:roundtable_seat}, len(game.get_player_units(False)))",
            "    alert;<blue>Roundtable</> is locked until more seats are filled!",
            "    finish",
            "end",
            "",
            "if;not {v:quest_name}",
            "    add_unit;Apoccy;{v:pos_apoccy};swoosh",
            "    wait;500;",
            "    disp_cursor;1",
            "    flicker_cursor;Apoccy",
            "    add_portrait;Apoccy;Left",
            "    speak;Apoccy;Quests open!",
            "    remove_portrait;Apoccy",
            "",
            "    level_var;quest_num;game.get_random(1,4)",
            "    if;len({v:avail_quest}) <= {v:quest_num}",
            "        game_var;quest_name;{v:avail_quest}",
            "    else",
            "        level_var;drawing_pots;{v:avail_quest}[0:10]",
            "        for;looper;range(0, {v:quest_num})",
            "            level_var;task;game.get_random_choice({v:drawing_pots})",
            "            level_var;drawing_pots;[un_item for un_item in {v:drawing_pots} if un_item != '{v:task}']            ",
            "            game_var;quest_name;{v:quest_name} + ['{v:task}']",
            "        endf",
            "    end",
            "    ",
            "    game_var;avail_quest;[looper for looper in {v:avail_quest}[0:10] if looper not in {v:quest_name}] + {v:avail_quest}[10::]",
            "    ",
            "    level_var;drawing_pots;['Location of ' + str(looper) for looper in {v:avail_quest}] + ['Location of Artifact ' + str(looper) for looper in {v:avail_reward} if looper not in {v:curr_reward}] + ['10000 golds'] + ['Addition of a Roundtable Seat|' + str(looper) for looper in range(0, min(max(len(game.get_player_units(False)), 0), 11) - {v:roundtable_seat} + 1)]",
            "    ",
            "    for;looper;range(0, len({v:quest_name}))",
            "        if;{v:quest_name}[{looper}][0:2] == 'Un'",
            "            game_var;quest_goal;{v:quest_goal} + ['Capture']",
            "        else",
            "            game_var;quest_goal;{v:quest_goal} + ['Capture' if game.get_random(0,1) else 'Neutralization']",
            "        end",
            "        ",
            "        level_var;reward;game.get_random_choice({v:drawing_pots})",
            "        if;'{v:reward}' != '10000 golds'",
            "            level_var;drawing_pots;[un_item for un_item in {v:drawing_pots} if un_item !='{v:reward}']",
            "        end",
            "        game_var;quest_reward;{v:quest_reward} + ['{v:reward}'.split('|')[0]]",
            "        ",
            "        game_var;quest_limit;{v:quest_limit} + [(game.get_random(1, {v:roundtable_seat}) + game.get_random(1, {v:roundtable_seat}) + 1) // 2]",
            "    endf",
            "        ",
            "    game_var;quest_penalty;{v:avail_penalty}[game.get_random(0, len({v:avail_penalty}) - 1)] if {v:avail_penalty} else 'Ragnarok'",
            "    game_var;quest_done;[False] * len({v:quest_name})",
            "    game_var;quest_success;[]",
            "    ",
            "    game_var;curr_reward;[]",
            "    game_var;curr_artifact;dict()",
            "end",
            "",
            "if;not all({v:quest_done})",
            "    game_var;quest_choice_choice_hover;0",
            "    textbox;quest_info;'{eval:{v:quest_goal}[{v:quest_choice_choice_hover}-1]} of <blue>{eval:{v:quest_name}[{v:quest_choice_choice_hover}-1]}</>.||<yellow>Participation Count:</> {eval:{v:quest_limit}[{v:quest_choice_choice_hover}-1]}.||<yellow>Reward:</> {eval:{v:quest_reward}[{v:quest_choice_choice_hover}-1]}.' if {v:quest_choice_choice_hover} else '<red>Warning:</>|Passing will incur the final war <jitter><blue>Ragnarok</>.' if '{v:quest_penalty}' == 'Ragnarok' else '<red>Warning:</>|Passing will incur penalty: Addition of UMA <blue>{v:quest_penalty}</>.||Accumulating 100 penalties will trigger <jitter><blue>Ragnarok</>.';top_left;120;8;hint;expression;no_warn",
            "    ",
            "    choice;quest_choice;<yellow>Penalty {v:tally_penalty}: {v:quest_penalty}</>;{eval:','.join([str(i) + '|Quest ' + str(i) for i in range(1, len({v:quest_name}) + 1)]) + ',0|<green>Pass</>'};;vert;bottom_right",
            "    remove_table;quest_info",
            "end",
            "",
            "if;not {v:quest_choice} or all({v:quest_done})",
            "    disp_cursor;1",
            "    flicker_cursor;Apoccy",
            "    add_portrait;Apoccy;Left",
            "    speak;Apoccy;Quest results!",
            "    ",
            "    for;looper;range(0, len({v:quest_name}))",
            "        level_var;un_looper;{looper}",
            "        textbox;quest_info;{eval:{v:quest_goal}[{v:un_looper}]} of <blue>{eval:{v:quest_name}[{v:un_looper}]}</>.||<yellow>Participation Count:</> {eval:{v:quest_limit}[{v:un_looper}]}.||<yellow>Reward:</> {eval:{v:quest_reward}[{v:un_looper}]}.;top_right;120;8;hint",
            "        speak;Apoccy;{eval:{v:quest_goal}[{looper}]} of {eval:{v:quest_name}[{looper}]},;0,30;100",
            "        ",
            "        if;{looper} not in {v:quest_success}",
            "            speak;Apoccy;<red>Fail!</>;0,30;100;noir",
            "            remove_table;quest_info",
            "            if;not ({v:quest_name}[{looper}][0:2] == 'Un' and game.check_dead({v:dict_unit}[{v:quest_name}[{looper}]]))",
            "                game_var;avail_quest;{v:avail_quest} + [{v:quest_name}[{looper}]]",
            "            end",
            "            ",
            "        elif;{v:quest_reward}[{looper}] == 'Addition of a Roundtable Seat'  ",
            "            level_var;un_pos;({v:pos_apoccy}[0] + min(max({v:pos_roundtable}[{v:roundtable_seat}-1][0], -2), 2), {v:pos_apoccy}[1] + min(max({v:pos_roundtable}[{v:roundtable_seat}-1][1], -2), 2))          ",
            "            inc_game_var;roundtable_seat;1",
            "            speak;Apoccy;<blue>Success!</>|Adding the {v:roundtable_seat}{eval:'st' if {v:roundtable_seat} == 1 else 'nd' if {v:roundtable_seat} == 2 else 'rd' if {v:roundtable_seat} == 3 else 'th'} Seat.;0,30;100                ",
            "            remove_table;quest_info",
            "            remove_portrait;Apoccy",
            "            disp_cursor;1",
            "            flicker_cursor;{v:un_pos}",
            "            map_anim;AOE_Rally;{v:un_pos};no_block",
            "            show_layer;seat_{v:roundtable_seat}",
            "            wait;1000",
            "            add_portrait;Apoccy;Left",
            "            ",
            "        elif;{v:quest_reward}[{looper}] == '10000 golds'",
            "            speak;Apoccy;<blue>Success!</>|Giving 10,000 golds.;0,30;100",
            "            give_money;10000;Union",
            "            remove_table;quest_info",
            "            ",
            "        else",
            "            level_var;un_reward;{v:quest_reward}[{looper}][12::]",
            "            speak;Apoccy;<blue>Success!</>|Marking {v:un_reward} on the map.;0,30;100",
            "            remove_table;quest_info",
            "            remove_portrait;Apoccy",
            "            ",
            "            transition;close",
            "            change_tilemap;Overworld;;Overworld;reload",
            "            transition;open",
            "            ",
            "            if;'{v:un_reward}'[0:8] == 'Artifact'",
            "                level_var;un_reward;'{v:un_reward}'[9::]",
            "                level_var;un_loc;game.get_random_choice({v:avail_loc})",
            "                game_var;curr_artifact;dict({v:curr_artifact}, {v:un_loc}= {v:curr_artifact}.get('{v:un_loc}', []) + ['{v:un_reward}'])",
            "            else",
            "                level_var;un_loc;{v:dict_loc}.get('{v:un_reward}')",
            "                game_var;curr_reward;{v:curr_reward} + ['{v:un_reward}']",
            "            end",
            "            ",
            "            level_var;un_pos;DB.levels.get('Overworld').regions.get('{v:un_loc}').position",
            "            center_cursor;{v:un_pos}",
            "            wait;500",
            "            map_anim;Snag;{v:un_pos}",
            "            make_generic;map_{looper};Pin;1;enemy",
            "            add_unit;map_{looper};{v:un_pos};immediate;stack;north",
            "            wait;2500",
            "            ",
            "            transition;close",
            "            change_tilemap;Roundtable;;Roundtable;reload",
            "            show_layer;seat_{v:roundtable_seat};immediate",
            "            add_portrait;Apoccy;Left",
            "            transition;open",
            "        end",
            "    endf",
            "    ",
            "    if;len({v:quest_success}) == len({v:quest_name})",
            "        speak;Apoccy;All quests have been cleared. Use your rewards wisely, you gonna need them.",
            "        ",
            "    elif;'{v:quest_penalty}' == 'Ragnarok'",
            "        speak;Apoccy;Ha!|HAHAHA!|It's starting, the final war|<orange>Ragnarok!</>;;;noir",
            "        lose_game",
            "        ",
            "    else",
            "        inc_game_var;tally_penalty;1",
            "        game_var;avail_penalty;[looper for looper in {v:avail_penalty} if looper != '{v:quest_penalty}']",
            "        game_var;avail_quest;{v:avail_quest} + ['{v:quest_penalty}']",
            "        load_unit;{v:quest_penalty};enemy",
            "        speak;Apoccy;You shall receive the penalty. Now adding...|<orange>UMA {v:quest_penalty}!</>;;;noir",
            "    end",
            "    ",
            "    game_var;quest_name;[]    ",
            "    game_var;quest_goal;[]",
            "    game_var;quest_done;[]",
            "    game_var;quest_limit;[]",
            "    game_var;quest_reward;[]",
            "    game_var;quest_success;[]",
            "    game_var;quest_penalty;''",
            "    ",
            "    remove_portrait;Apoccy",
            "    remove_unit;Apoccy;swoosh",
            "end",
            "",
            "############################################################################################",
            "",
            "game_var;avail_quest;['Untruth', 'Unchange', 'Unseen', 'Unmove', 'Colour', 'Foresight']",
            "game_var;avail_penalty;['Fog']",
            "game_var;avail_reward;[]",
            "game_var;avail_loc;['Uk', 'France', 'Romania', 'Moscow', 'Turkey', 'Siberia', 'Japan', 'Taiwan', 'HongKong', 'Buroja', 'Aus', 'Vancouver', 'Vegas', 'Nyc', 'Rio']",
            "",
            "game_var;avail_loc;[]",
            "",
            "game_var;dict_loc;dict(Untruth='HongKong', Unchange='Siberia', Unseen='Rio', Unmove='Rio', Unbreakable='Japan', Unchaste='Japan', Unburn='Nyc', Colour='Japan', Spoil='Vegas', Galaxy='Aus')",
            "game_var;dict_unit;dict(Untruth='Shen', Unchange='Gina', Unseen='Sean', Unmove='Chikara')",
            "",
            "game_var;quest_name;[]",
            "game_var;quest_goal;[]",
            "game_var;quest_done;[]",
            "game_var;quest_limit;[]",
            "game_var;quest_reward;[]",
            "game_var;quest_success;[]",
            "game_var;quest_penalty;''",
            "",
            "game_var;curr_quest;-1",
            "game_var;curr_reward;[]",
            "game_var;curr_artifact;dict()",
            "",
            "game_var;pos_map;(15,5)",
            "game_var;pos_apoccy;(7,9)",
            "game_var;pos_roundtable;[(-1,-3),(1,-3),(-3,-1),(3,-1),(-3,0),(3,0),(-3,1),(3,1),(-1,3),(1,3),(0,3)]",
            "",
            "game_var;roundtable_seat;2",
            "game_var;tally_penalty;1",
            "",
            "game_var;version;'0.1'",
            "",
            "enable_convoy;true",
            "",
            "############################################################################################",
            "    ",
            "for;un_unit;[_unit.nid for _unit in game.get_all_units() if _unit.get_skill(\"Unchange\")]",
            "    level_var;unchange_lvl;1 + (u(\"{un_unit}\").get_internal_level() // 10)",
            "    set_stats;{un_unit};Unchange_Tally,{v:unchange_lvl};immediate",
            "    give_skill;{un_unit};{eval: \"Unchange_\" + \"{v:unchange_lvl}\"};no_banner",
            "endf",
            "",
            "############################################################################################",
            "",
            "add_region;{eval:'Unchange_Barrier|' + unit.nid + '|' + str(target_pos)};{target_pos};1,1;terrain;Unchange_Barrier;3",
            "map_anim;BlueDot;{target_pos};permanent",
            "",
            "remove_skill;{unit};{eval: \"Unchange_\" + str(unit.get_stat(\"Unchange_Tally\"))};no_banner",
            "change_stats;{unit};Unchange_Tally,-1;immediate",
            "give_skill;{unit};{eval: \"Unchange_\" + str(unit.get_stat(\"Unchange_Tally\"))};no_banner",
            "",
            "remove_map_anim;BlueDot;{position}",
            "level_var;un_unit;region.nid.split('|')[1]",
            "",
            "level_var;un_lvl;u(\"{v:un_unit}\").get_stat(\"Unchange_Tally\")              ",
            "remove_skill;{v:un_unit};{eval: \"Unchange_\" + str({v:un_lvl})};no_banner",
            "change_stats;{v:un_unit};Unchange_Tally,1;immediate",
            "give_skill;{v:un_unit};{eval: \"Unchange_\" + str({v:un_lvl} + 1)};no_banner",
            "",
            "############################################################################################",
            "",
            "level_var;un_unit1;unit.nid",
            "level_var;un_unit2;unit.nid",
            "level_var;un_lvl;unit.stats.get('MOV') + skill_system.sight_range(unit) + 1",
            "",
            "level_var;dx;position[0] - target_pos[0]",
            "level_var;dy;position[1] - target_pos[1]",
            "level_var;un_dir;(({v:dx})**2)*3 + (({v:dy})**2)*2 + {v:dx} - {v:dy}",
            "",
            "for;mode;range(-1,2)",
            "    trigger_script_with_args;Global Unmove Recursion;un_row,1,un_col,1,mode,{mode}",
            "endf",
            "",
            "############################################################################################",
            "",
            "if;unit.get_skill('Unmove_grandchild') and game.cursor.path",
            "    for;un_region;set(region.nid for region in game.level.regions if region.position == unit.position and region.nid.split('|')[0] == 'Unmove_Region')",
            "        level_var;un_unit1;'{un_region}'.split('|')[1]",
            "        level_var;un_unit2;'{un_region}'.split('|')[2]",
            "        level_var;un_dir;int('{un_region}'.split('|')[3])",
            "        level_var;un_lvl;u('{v:un_unit1}').stats.get('MOV')+skill_system.sight_range(u('{v:un_unit1}'))+1",
            "    ",
            "        trigger_script;Global Unmove Deactivate;{v:un_unit1}",
            "            ",
            "        for;mode;range(-1,2)",
            "            trigger_script_with_args;Global Unmove Recursion;un_row,1,un_col,1,mode,{mode}",
            "        endf",
            "    endf",
            "    ",
            "elif;unit.has_rescued",
            "    level_var;un_pos;[act.old_pos for act in game.action_log.actions if hasattr(act, 'rescuee') and act.unit == unit][-1]",
            "    for;un_region;set(region.nid for region in game.level.regions if region.position == {v:un_pos} and region.nid.split('|')[0] == 'Unmove_Region')",
            "        level_var;un_unit1;'{un_region}'.split('|')[1]",
            "        level_var;un_unit2;'{un_region}'.split('|')[2]",
            "        level_var;un_dir;int('{un_region}'.split('|')[3])",
            "        level_var;un_lvl;u('{v:un_unit1}').stats.get('MOV')+skill_system.sight_range(u('{v:un_unit1}'))+1",
            "    ",
            "        trigger_script;Global Unmove Deactivate;{v:un_unit1}",
            "            ",
            "        for;mode;range(-1,2)",
            "            trigger_script_with_args;Global Unmove Recursion;un_row,1,un_col,1,mode,{mode}",
            "        endf",
            "    endf",
            "        ",
            "elif;unit.has_dropped",
            "    level_var;un_unit;[act.droppee for act in game.action_log.actions if hasattr(act, 'droppee') and act.unit == unit][-1].nid",
            "        ",
            "    if;u('{v:un_unit}').get_skill('Unmove_child')",
            "        level_var;un_unit1;'{v:un_unit}'",
            "        level_var;un_unit2;'{v:un_unit}'",
            "        level_var;un_lvl;u('{v:un_unit}').stats.get('MOV')+skill_system.sight_range(u('{v:un_unit}'))+1",
            "",
            "        level_var;un_pos;game.cursor.path[-1] if game.cursor.path and len(game.cursor.path) - 1 + unit.movement_left < unit.get_stat('MOV') else position",
            "",
            "        level_var;dx;{v:un_pos}[0] - u('{v:un_unit}').position[0]",
            "        level_var;dy;{v:un_pos}[1] - u('{v:un_unit}').position[1]",
            "",
            "        if;{v:dx}*{v:dy} or {v:dx} not in range(-1, 2) or {v:dy} not in range(-1, 2)    ",
            "            level_var;dx;game.cursor.path[-1][0] - u('{v:un_unit}').position[0]",
            "            level_var;dy;game.cursor.path[-1][1] - u('{v:un_unit}').position[1]",
            "        end",
            "",
            "        level_var;un_dir;(({v:dx})**2)*3 + (({v:dy})**2)*2 + {v:dx} - {v:dy}",
            "    ",
            "        trigger_script;Global Unmove Deactivate;{v:un_unit}",
            "            ",
            "        for;mode;range(-1,2)",
            "            trigger_script_with_args;Global Unmove Recursion;un_row,1,un_col,1,mode,{mode}",
            "        endf",
            "    ",
            "    elif;u('{v:un_unit}').get_skill('Unmove_grandchild')",
            "        for;un_region;set(region.nid for region in game.level.regions if region.position == u('{v:un_unit}').position and region.nid.split('|')[0] == 'Unmove_Region')",
            "            level_var;un_unit1;'{un_region}'.split('|')[1]",
            "            level_var;un_unit2;'{un_region}'.split('|')[2]",
            "            level_var;un_dir;int('{un_region}'.split('|')[3])",
            "            level_var;un_lvl;u('{v:un_unit1}').stats.get('MOV')+skill_system.sight_range(u('{v:un_unit1}'))+1",
            "    ",
            "            trigger_script;Global Unmove Deactivate;{v:un_unit1}",
            "                ",
            "            for;mode;range(-1,2)",
            "                trigger_script_with_args;Global Unmove Recursion;un_row,1,un_col,1,mode,{mode}",
            "            endf",
            "        endf",
            "    end",
            "end",
            "",
