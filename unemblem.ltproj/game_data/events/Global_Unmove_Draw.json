[
    {
        "name": "Unmove Draw",
        "trigger": null,
        "level_nid": null,
        "condition": "True",
        "commands": [],
        "only_once": false,
        "priority": 20,
        "_source": [
            "#pyev1",
            "from app.engine.bresenham_line_algorithm import get_line",
            "",
            "negator, carrier, dir = v('unmove_parameters')",
            "",
            "if isinstance(dir, str):",
            "    dir = tuple(int(i) for i in dir.replace('(', '').replace(')', '').split(','))",
            "    ",
            "pos = u(carrier).position",
            "max_range = u(negator).stats.get('MOV') + skill_system.sight_range(u(negator)) + 1",
            "",
            "for row in range(1, max_range+1):",
            "    for col in range(-row, row+1):",
            "        if utils.distance((0, 0), (row, col)) >= max_range + 0.3:",
            "            continue",
            "            ",
            "        target = utils.tuple_add(pos, utils.tmult(dir, row), utils.tmult(dir[::-1],col))",
            "        if not game.board.check_bounds(target):",
            "            continue",
            "    ",
            "        if get_line(pos, target, lambda p: game.board.get_opacity(p) or ((u:=game.board.get_unit(p)) and 'Invisible' not in u.tags)):",
            "            nid = 'Unmove_Region|%s|%s|%s|%s' % (negator, carrier, str(dir), str(target))",
            "            condition = \"'Invisible' not in unit.tags and unit.nid != '%s'\" % carrier",
            "            $add_region nid target (1,1) 'status' 'Unmove_grandchild' None None 'lightyellow', interrupt_move",
            "            $region_condition nid condition"
        ],
        "nid": "Global Unmove Draw"
    }
]