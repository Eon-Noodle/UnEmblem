[
    {
        "name": "Quest System",
        "trigger": "on_region_interact",
        "level_nid": "Union",
        "condition": "region.nid == 'Roundtable_Seat'",
        "commands": [],
        "only_once": false,
        "priority": 20,
        "_source": [
            "#pyev1",
            "",
            "if len(game.get_units_in_party()) < v('roundtable_seat') and len(game.get_units_in_party('Union')):",
            "    $alert '<blue>Roundtable</> is locked until more seats are filled!'",
            "    $finish",
            "    ",
            "$m 'Mission'",
            "",
            "if not game.quest_manager.is_quest_phase():",
            "    game.quest_manager.start_quest_phase()",
            "    ",
            "    $add 'Apoccy' v('pos_apoccy') 'swoosh'",
            "    $wait 500",
            "    $disp_cursor True",
            "    $highlight 'Apoccy'",
            "    $u 'Apoccy' 'Left'",
            "    $s 'Apoccy' 'Quests open!'",
            "    $r 'Apoccy'",
            "",
            "if not game.quest_manager.is_done():",
            "    info = \"{e:game.quest_manager.get_quest_info({v:quest_choice_choice_hover})}\"    ",
            "    title, options = game.quest_manager.get_quest_choice()",
            "    ",
            "    $gvar 'quest_choice_choice_hover' 0",
            "    $textbox 'quest_info' info 'top_left' 120 8 'hint', expression",
            "    $choice 'quest_choice' title options None 'vert' 'bottom_right'",
            "    $rmtable 'quest_info'",
            "",
            "if game.quest_manager.is_done():",
            "    $disp_cursor True",
            "    $highlight 'Apoccy'",
            "    $u 'Apoccy' 'Left'",
            "    $s 'Apoccy' 'Quest results!'",
            "    ",
            "    for idx, quest in enumerate(game.quest_manager.quests.values()):",
            "        pos, msg, res = game.quest_manager.quest_result(quest)",
            "        ",
            "        $textbox 'quest_info' quest.get_blurb() (120, 16) 120 8 'hint'",
            "        $s 'Apoccy' msg (0,30) 100",
            "        $rmtable 'quest_info'",
            "        ",
            "        if res == 'seat':",
            "            $ginc 'roundtable_seat' 1",
            "            $r 'Apoccy'",
            "            $disp_cursor True",
            "            $highlight pos",
            "            $map_anim 'AOE_Rally' pos, no_block",
            "            $show_layer ('seat_%d' % v('roundtable_seat'))",
            "            $wait 1000",
            "            $u 'Apoccy' 'Left'",
            "            ",
            "        elif res == 'money':",
            "            $give_money 10000",
            "            ",
            "        elif res == 'location':               ",
            "            $t 'close'",
            "            $r 'Apoccy'",
            "            $change_tilemap 'Overworld' None 'Overworld', reload",
            "            $enable_fog_of_war False",
            "            $center_cursor pos",
            "            $t 'open'",
            "",
            "            $wait 500",
            "            $map_anim 'Snag' pos",
            "            $make_generic ('map_%d' % idx) 'Pin' 1 'enemy'",
            "            $add ('map_%d' % idx) pos 'immediate' 'stack' 'north'",
            "            $wait 2500",
            "            ",
            "            $t 'close'",
            "            $change_tilemap 'Roundtable' None 'Roundtable', reload",
            "            for layer in ['gears', 'roundtable_upper', 'roundtable_lower'] + ['seat_%d' % (idx+1) for idx in range(v('roundtable_seat'))]:",
            "                $show_layer layer, immediate",
            "            $enable_fog_of_war True",
            "            $u 'Apoccy' 'Left'",
            "            $t 'open'",
            "    ",
            "    msg, sty, res = game.quest_manager.end_quest_phase()",
            "    $s 'Apoccy' msg None None sty",
            "    ",
            "    if res == 'ragnarok':",
            "        $lose_game",
            "        ",
            "    elif res == 'penalty':",
            "        $load_unit game.quest_manager.penalty 'enemy'",
            "    ",
            "    $r 'Apoccy'",
            "    $remove 'Apoccy' 'swoosh'",
            "",
            "elif not int(v('quest_choice')):",
            "    $u 'Dev' 'Right'",
            "    $s 'Dev' 'Sorry, the demo ends here.'",
            "    $r 'Dev'"
        ],
        "nid": "Union Quest System"
    }
]